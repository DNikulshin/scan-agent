# Скопируй этот файл в .env и заполни значения.
# Полную карту переменных см. в CLAUDE.md → Environment Variables.

# ─── OpenRouter (AI-скоринг и питч) ───
OPENROUTER_API_KEY=

# ─── Telegram bot ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Web Push (VAPID) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Dashboard ───
DASHBOARD_URL=http://localhost:3000
DASHBOARD_API_KEY=

# ─── Database (Prisma Postgres) ───
DATABASE_URL=
# Для SSE / LISTEN-NOTIFY (non-pooled). Если не задано — fallback на DATABASE_URL.
DATABASE_URL_DIRECT=

# ─── Парсеры (опциональные флаги) ───
FL_ENABLED=true
FL_GENERATE_PITCH=false
FL_ONLY_FREE_RESPONSES=true
FREELANCERU_ENABLED=true
HABR_ENABLED=true
HH_ENABLED=true

# ─── GitHub профиль (Блок 2 — динамический ProfileSnapshot) ───
# Префикс GH_ — а не GITHUB_ — иначе GitHub Actions блокирует переменные.
GH_PROFILE_LOGIN=
GH_PROFILE_TOKEN=
GH_PROFILE_MAX_AGE_HOURS=24

# ─── Profile snapshots: FL.ru / Kwork / HH резюме / Freelance.ru (Блок 2 расширение) ───
# Публичные URL'ы; парсеры пропускаются если значение пустое.
HH_RESUME_PUBLIC_URL=https://hh.ru/resume/aa491224ff0fb59c3b0039ed1f56367334384d
FREELANCERU_PROFILE_URL=https://freelance.ru/dnikulshin
KWORK_PROFILE_URL=https://kwork.ru/user/dnikulshin
FL_PROFILE_URL=https://www.fl.ru/users/dnikulshindev/portfolio/
PROFILE_SNAPSHOT_MAX_AGE_HOURS=24
